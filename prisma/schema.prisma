generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ==================== ENUMS ====================

enum UserRole {
  SUPER_ADMIN
  HR
  EMPLOYEE
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
}

enum LeaveType {
  ANNUAL
  EXCUSE
  UNPAID
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
}

enum NotificationType {
  TEST_ASSIGNED
  TASK_ASSIGNED
  LEAVE_APPROVED
  LEAVE_REJECTED
  TEST_DEADLINE
  TASK_DEADLINE
  GENERAL
}

// ==================== MODELS ====================

model Tenant {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  logoUrl   String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users        User[]
  departments  Department[]
  positions    Position[]
  tests        Test[]
  tasks        Task[]
  leaveRequests LeaveRequest[]
  nineBoxEvaluations NineBoxEvaluation[]
  notifications Notification[]

  @@map("tenants")
}

model User {
  id             String   @id @default(cuid())
  tenantId       String
  name           String
  email          String
  passwordHash   String
  role           UserRole @default(EMPLOYEE)
  phone          String?
  birthDate      DateTime?
  startDate      DateTime?
  annualLeaveDays Int     @default(14)
  passwordResetToken  String?
  passwordResetExpiry DateTime?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  tenant       Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  department   Department? @relation("DepartmentMembers", fields: [departmentId], references: [id])
  departmentId String?
  position     Position?   @relation(fields: [positionId], references: [id])
  positionId   String?
  manager      User?       @relation("ManagerSubordinates", fields: [managerId], references: [id])
  managerId    String?
  subordinates User[]      @relation("ManagerSubordinates")

  // Departman yöneticisi olarak
  managedDepartments Department[] @relation("DepartmentManager")

  // Test ilişkileri
  createdTests    Test[]           @relation("TestCreator")
  testAssignments TestAssignment[] @relation("AssignedTests")
  assignedTests   TestAssignment[] @relation("TestAssigner")
  testResults     TestResult[]

  // Görev ilişkileri
  assignedTasks   Task[] @relation("TaskAssignee")
  createdTasks    Task[] @relation("TaskCreator")

  // İzin ilişkileri
  leaveRequests   LeaveRequest[] @relation("LeaveRequester")
  reviewedLeaves  LeaveRequest[] @relation("LeaveReviewer")

  // 9-Box
  nineBoxEvaluations NineBoxEvaluation[] @relation("EvaluatedUser")
  givenEvaluations   NineBoxEvaluation[] @relation("Evaluator")

  // Bildirimler
  notifications Notification[]

  @@unique([email, tenantId])
  @@index([tenantId])
  @@index([departmentId])
  @@map("users")
}

model Department {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  manager   User?      @relation("DepartmentManager", fields: [managerId], references: [id])
  managerId String?
  members   User[]     @relation("DepartmentMembers")
  positions Position[]

  @@unique([name, tenantId])
  @@index([tenantId])
  @@map("departments")
}

model Position {
  id           String   @id @default(cuid())
  tenantId     String
  departmentId String?
  name         String
  level        Int      @default(1)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant     Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  department Department? @relation(fields: [departmentId], references: [id])
  users      User[]

  @@index([tenantId])
  @@map("positions")
}

model Test {
  id              String   @id @default(cuid())
  tenantId        String
  createdById     String
  title           String
  description     String?
  durationMinutes Int?
  isRepeatable    Boolean  @default(false)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant          Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdBy       User               @relation("TestCreator", fields: [createdById], references: [id])
  questions       Question[]
  categoryWeights TestCategoryWeight[]
  assignments     TestAssignment[]
  results         TestResult[]

  @@index([tenantId])
  @@map("tests")
}

model Question {
  id                String   @id @default(cuid())
  testId            String
  questionText      String
  category          String
  correctOptionIndex Int
  createdAt         DateTime @default(now())

  test    Test             @relation(fields: [testId], references: [id], onDelete: Cascade)
  options QuestionOption[]

  @@index([testId])
  @@map("questions")
}

model QuestionOption {
  id         String @id @default(cuid())
  questionId String
  optionText String
  orderIndex Int

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([questionId])
  @@map("question_options")
}

model TestCategoryWeight {
  id               String @id @default(cuid())
  testId           String
  category         String
  weightPercentage Float

  test Test @relation(fields: [testId], references: [id], onDelete: Cascade)

  @@unique([testId, category])
  @@map("test_category_weights")
}

model TestAssignment {
  id         String    @id @default(cuid())
  testId     String
  assignedToId String
  assignedById String
  deadline   DateTime?
  assignedAt DateTime  @default(now())

  test       Test @relation(fields: [testId], references: [id], onDelete: Cascade)
  assignedTo User @relation("AssignedTests", fields: [assignedToId], references: [id])
  assignedBy User @relation("TestAssigner", fields: [assignedById], references: [id])

  @@index([testId])
  @@index([assignedToId])
  @@map("test_assignments")
}

model TestResult {
  id              String   @id @default(cuid())
  testId          String
  userId          String
  totalScore      Float
  categoryScores  Json
  completedAt     DateTime @default(now())
  durationSeconds Int?

  test Test @relation(fields: [testId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id])

  @@index([testId])
  @@index([userId])
  @@map("test_results")
}

model Task {
  id          String       @id @default(cuid())
  tenantId    String
  title       String
  description String?
  priority    TaskPriority @default(MEDIUM)
  deadline    DateTime?
  status      TaskStatus   @default(PENDING)
  assignedToId String?
  assignedById String
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  completedAt DateTime?

  tenant     Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  assignedTo User?  @relation("TaskAssignee", fields: [assignedToId], references: [id])
  assignedBy User   @relation("TaskCreator", fields: [assignedById], references: [id])

  @@index([tenantId])
  @@index([assignedToId])
  @@map("tasks")
}

model LeaveRequest {
  id          String      @id @default(cuid())
  userId      String
  tenantId    String
  leaveType   LeaveType
  startDate   DateTime
  endDate     DateTime
  description String?
  status      LeaveStatus @default(PENDING)
  reviewedById String?
  reviewNote  String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  user       User   @relation("LeaveRequester", fields: [userId], references: [id])
  tenant     Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  reviewedBy User?  @relation("LeaveReviewer", fields: [reviewedById], references: [id])

  @@index([userId])
  @@index([tenantId])
  @@map("leave_requests")
}

model NineBoxEvaluation {
  id               String   @id @default(cuid())
  userId           String
  tenantId         String
  evaluatorId      String
  performanceScore Float
  potentialScore   Float
  notes            String?
  evaluatedAt      DateTime @default(now())

  user      User   @relation("EvaluatedUser", fields: [userId], references: [id])
  tenant    Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  evaluator User   @relation("Evaluator", fields: [evaluatorId], references: [id])

  @@index([userId])
  @@index([tenantId])
  @@map("nine_box_evaluations")
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  tenantId  String
  type      NotificationType
  title     String
  message   String
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tenantId])
  @@map("notifications")
}
